    "# COMPLETE WORKFLOW\n",
    "\n",
    "# Import necessary packages\n",
    "import pandas as pd\n",
    "\n",
    "# Read in the data\n",
    "catch_data = pd.read_csv('data/salmon_data.csv')\n",
    "\n",
    "# Filter the dataframe to exclude the 'notesRegCode' column\n",
    "catch_data = catch_data[['Region', 'Year', 'Species', 'Catch']]\n",
    "\n",
    "# Update where the 'Catch' column is 'I' to 1 \n",
    "catch_data.at[400,'Catch'] = 1\n",
    "\n",
    "# Update 'Catch' to integers data type\n",
    "catch_data['Catch'] = catch_data['Catch'].astype('int64')\n",
    "\n",
    "# Create a dataframe of mean salmon catch per region\n",
    "avg_region = catch_data.groupby('Region')['Catch'].mean()\n",
    "\n",
    "# Plot average salmon catch per region\n",
    "(avg_region\n",
    "    .sort_values()\n",
    "    .plot(kind='barh',\n",
    "          title = 'Average Salmon Catch Per Region (1878 - 1997)',\n",
    "          xlabel = 'Average number of salmon caught',\n",
    "          ylabel = 'Region'))"
   ]
  },
